{
  "manifest_version": 3,
  "name": "San4 Live Coach",
  "version": "0.1.0",
  "description": "Get coached on how you communicate during your real calls. Live transcript, then a rating with fillers, fixes, and what to watch to improve.",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "San4 Live Coach",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png" }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://san4.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "src/lib/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
